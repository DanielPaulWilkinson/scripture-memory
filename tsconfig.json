{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "jsx": "preserve", "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "noEmit": true, "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
